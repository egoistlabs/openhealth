# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# companion turn log: holds what a crew member typed, stays on this machine
/.logs/

# BodyParts3D GLBs, copied from node_modules on postinstall
/public/somakine/
