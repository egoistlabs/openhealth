# Copy this file to web/.env, then start (or restart) `pnpm dev`.
# These three lines are all you need to run Pedro on Ollama:
LOCAL_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medgemma:4b

# ---------------------------------------------------------------------------
# Everything below is optional. Uncomment a line only to change it.
# ---------------------------------------------------------------------------

# Use the Anthropic Claude API instead of Ollama. Messages then leave the laptop.
# LOCAL_LLM=false
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5

# Turn off the AI safety label and use only the keyword safety checks.
# SAFETY_CLASSIFIER=0

# Wait this long (ms) for the AI safety label before the keywords decide alone.
# SAFETY_CLASSIFIER_TIMEOUT_MS=60000

# Stop writing each chat turn to web/.logs/companion-turns.jsonl.
# COMPANION_TURN_LOG=off
