# Copy to web/.env (Next.js reads it from this folder) and restart `pnpm dev`.
# Every line is optional: the values shown are the defaults.

# --- Model provider -------------------------------------------------------
# true: Ollama on this machine (nothing leaves the laptop).
# false: Anthropic Claude API (sends the question, history, numbers and
#        brain excerpts to Anthropic). There is no silent fallback.
LOCAL_LLM=true

# Ollama (LOCAL_LLM=true)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medgemma:4b
# Only needed if your Ollama endpoint sits behind a key.
# OLLAMA_API_KEY=

# Anthropic (LOCAL_LLM=false)
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Safety checks --------------------------------------------------------
# The model's safety label runs alongside the keyword checks. Set to 0 to
# use the keyword checks only.
SAFETY_CLASSIFIER=1
# How long to wait for the safety label before the keywords decide alone.
SAFETY_CLASSIFIER_TIMEOUT_MS=60000

# --- Paths and logs -------------------------------------------------------
# Where the brain folder is, relative to web/. Found automatically if unset.
# BRAIN_DIR=../brain
# Turn log file, relative to web/. Defaults to .logs/companion-turns.jsonl.
# Set to "off" to stop logging turns.
# COMPANION_TURN_LOG=.logs/companion-turns.jsonl

# Tip: start Ollama with OLLAMA_NUM_PARALLEL=2 (an Ollama server setting,
# not read from this file) so the safety check and the reply each keep
# their prompt cached.
